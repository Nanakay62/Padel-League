{
  "name": "padel-ghana-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build",
    "build:club": "tsc && vite build --mode club",
    "build:admin": "tsc && vite build --mode admin",
    "build:prod": "tsc && vite build && node scripts/validate_portal_build.mjs",
    "preview": "vite preview --port 3000",
    "test:gate": "node tests/validate-portal-build.test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
