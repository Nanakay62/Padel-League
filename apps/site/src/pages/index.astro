---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Padel Ghana — Padel in Ghana, organised."
  description="Find games and players in Accra. Join Americano events at your level, enter scores on the court, and track live standings."
>
  <!-- 1. HERO SECTION (Gradient band with photo overlay) -->
  <section class="band-gradient-hero hero-section" id="hero">
    <div class="container hero-container">
      <div class="hero-grid">
        <!-- Hero Copy -->
        <div class="hero-content">
          <h1 class="hero-title">
            Find <span class="text-lime">games</span> and <span class="text-lime">players</span> in Accra.
          </h1>
          <p class="hero-subtitle">
            Find games at your level, join in a few taps, and follow live scores on the court.
          </p>
          <div class="hero-actions">
            <a href={`${siteConfig.appUrl}/events`} class="btn btn-lime hero-btn-cta" id="hero-find-game-btn">
              Find a game
            </a>
            <a href={`${siteConfig.appUrl}/venues`} class="btn btn-glass-on-blue hero-btn-secondary" id="hero-browse-clubs-btn">
              Browse clubs
            </a>
          </div>
        </div>

        <!-- Hero Photo with 88% White Glass Floating Card -->
        <div class="hero-media">
          <div class="hero-photo-wrapper">
            <img
              src="/images/hero-players.jpg"
              alt="Ghanaian padel players at outdoor padel court in Accra checking match scores on phone"
              class="hero-photo"
              width="640"
              height="440"
              loading="eager"
            />
            <!-- Floating Card Over Photo (Strictly 88% white card with dark text) -->
            <div class="card-photo-overlay hero-floating-card">
              <div class="floating-header">
                <div>
                  <h2 class="floating-venue-name">Accra Club</h2>
                  <p class="floating-match-type">Americano Open &bull; Level 2.0–3.5</p>
                </div>
                <span class="badge-pill badge-success">Confirmed</span>
              </div>
              <div class="floating-footer">
                <div class="floating-price">
                  <span class="tnum price-val">GH&cent;&nbsp;85.00</span>
                  <span class="price-unit">/ player</span>
                </div>
                <span class="floating-meta">8 spots confirmed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. HOW IT WORKS SECTION (Solid surface) -->
  <section class="section-padded surface-base" id="how-it-works">
    <div class="container space-y-lg">
      <div class="section-header">
        <span class="section-eyebrow">Simplicity First</span>
        <h2 class="section-title">How it works</h2>
        <p class="section-subtitle">
          A frictionless flow from finding a game to the post-match WhatsApp debrief.
        </p>
      </div>

      <div class="grid-3">
        <!-- Step 1 -->
        <div class="card-solid step-card">
          <div class="step-card-top">
            <div class="step-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <span class="step-number">Step 01</span>
            <h3 class="step-title">Browse Americano events at your level</h3>
          </div>
          <p class="step-desc">
            Browse organized social tournaments, open Americano brackets, and casual practice blocks tailored to your skill rating.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="card-solid step-card">
          <div class="step-card-top">
            <div class="step-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
            <span class="step-number">Step 02</span>
            <h3 class="step-title">Pay by mobile money or cash; the organiser confirms your spot</h3>
          </div>
          <p class="step-desc">
            Use MTN MoMo, Telecel Cash, AT Money, or hand cash to the desk manager. Your slot is guaranteed once verified.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="card-solid step-card">
          <div class="step-card-top">
            <div class="step-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </div>
            <span class="step-number">Step 03</span>
            <h3 class="step-title">Enter scores with plus and minus buttons and follow the live leaderboard</h3>
          </div>
          <p class="step-desc">
            Record points tap-by-tap courtside. Track individual standings on your phone or follow along on the clubhouse screen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. FORMATS SECTION (Ice blue solid surface) -->
  <section class="section-padded band-ice-surface" id="formats">
    <div class="container space-y-lg">
      <div class="section-header">
        <h2 class="section-title">Tournament formats made for Ghana</h2>
        <p class="section-subtitle">
          Fast, social, and competitive match setups tailored for local padel clubs and social nights.
        </p>
      </div>

      <div class="grid-2">
        <!-- Americano Card -->
        <div class="card-solid format-card">
          <div class="format-card-body">
            <div class="format-header">
              <div>
                <h3 class="format-name">Americano</h3>
                <span class="badge-pill badge-success">Social &amp; Fair</span>
              </div>
            </div>
            <p class="format-desc">
              Social, rotate partners every round, everyone plays with everyone. Enter as a solo player, match points count directly toward your personal tournament tally.
            </p>
            <ul class="format-bullets">
              <li class="bullet-item">
                <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>No fixed partner needed &mdash; enter as a solo player.</span>
              </li>
              <li class="bullet-item">
                <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>All skill levels mixed smoothly with guaranteed round rotation.</span>
              </li>
              <li class="bullet-item">
                <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Each match plays to set points (e.g. 24 or 32 total points).</span>
              </li>
            </ul>
          </div>

          <!-- Schematic Box -->
          <div class="schematic-box">
            <div class="schematic-top">
              <span class="schematic-title">Round Rotation Sample</span>
              <span class="schematic-meta tnum">24 Pts Total</span>
            </div>
            <div class="schematic-court">
              <div class="court-team">P1 &amp; P2 vs P3 &amp; P4</div>
              <div class="court-net">&mdash;&mdash;&mdash; NET &mdash;&mdash;&mdash;</div>
              <div class="court-team">Next: P1 &amp; P3 vs P2 &amp; P4</div>
            </div>
          </div>
        </div>

        <!-- Mexicano Card -->
        <div class="card-solid format-card">
          <div class="format-card-body">
            <div class="format-header">
              <div>
                <h3 class="format-name">Mexicano</h3>
                {siteConfig.flags.MEXICANO_AVAILABLE ? (
                  <span class="badge-pill badge-gold">Competitive &amp; Dynamic</span>
                ) : (
                  <span class="badge-pill badge-soon">Coming Soon</span>
                )}
              </div>
            </div>
            <p class="format-desc">
              Pairings follow the live leaderboard. First round is random, then subsequent rounds rebuild pairings from current standings so top-ranked players are matched with and against each other.
            </p>
            <ul class="format-bullets">
              <li class="bullet-item">
                <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Live ladder re-seeding after every match round.</span>
              </li>
              <li class="bullet-item">
                <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Closer point spreads as high-ranked players face each other.</span>
              </li>
              <li class="bullet-item">
                <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Rewards consistent courtside performance throughout the session.</span>
              </li>
            </ul>
          </div>

          <!-- Schematic Box -->
          <div class="schematic-box">
            <div class="schematic-top">
              <span class="schematic-title">Dynamic Pairing Model</span>
              <span class="schematic-meta">Dynamic Seeding</span>
            </div>
            <div class="schematic-court">
              <div class="court-team">Rank 1 &amp; Rank 3 vs Rank 2 &amp; Rank 4</div>
              <div class="court-net">&mdash;&mdash;&mdash; NET &mdash;&mdash;&mdash;</div>
              <div class="court-team">Rank 5 &amp; Rank 7 vs Rank 6 &amp; Rank 8</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Leagues Coming Soon Strip -->
      <div class="card-solid leagues-strip">
        <div class="leagues-strip-left">
          <svg class="clock-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span class="leagues-title">Leagues, coming soon</span>
        </div>
        <span class="leagues-desc">Multi-week club divisions in development</span>
      </div>
    </div>
  </section>

  <!-- 4. FEATURES GRID (6 CARDS ON SOLID SURFACE) -->
  <section class="section-padded surface-base" id="features">
    <div class="container space-y-lg">
      <div class="section-header">
        <span class="section-eyebrow">Built for local courts</span>
        <h2 class="section-title">Everything needed to play and run padel</h2>
      </div>

      <div class="grid-3">
        <!-- Feature 1 -->
        <div class="card-solid feature-card">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 4 23 10 17 10"></polyline>
              <polyline points="1 20 1 14 7 14"></polyline>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
          </div>
          <h3 class="feature-title">Fair rotations</h3>
          <p class="feature-desc">
            Automated pairing ensures everyone plays balanced matches across every round with no duplicate partnerships.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="card-solid feature-card">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="1" y1="1" x2="23" y2="23"></line>
              <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
              <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
              <path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path>
              <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
              <line x1="12" y1="20" x2="12.01" y2="20"></line>
            </svg>
          </div>
          <h3 class="feature-title">Live scoring that works offline</h3>
          <p class="feature-desc">
            Big tactile buttons on court that continue saving even if network signal drops. Syncs automatically when back online.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="card-solid feature-card">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"></path>
              <path d="M4 6v12c0 1.1.9 2 2 2h14v-4"></path>
              <path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"></path>
            </svg>
          </div>
          <h3 class="feature-title">Pay in cedis (MoMo or cash)</h3>
          <p class="feature-desc">
            MTN MoMo, Telecel Cash, AT Money or club desk cash in GH&cent;; organiser confirms your entry directly on their roster.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="card-solid feature-card">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </div>
          <h3 class="feature-title">Share results to WhatsApp</h3>
          <p class="feature-desc">
            1-tap summary export of standings, round scores, and podium finishers directly to community WhatsApp groups.
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="card-solid feature-card">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
              <line x1="8" y1="2" x2="8" y2="18"></line>
              <line x1="16" y1="6" x2="16" y2="22"></line>
            </svg>
          </div>
          <h3 class="feature-title">Club pages with courts and directions</h3>
          <p class="feature-desc">
            Court specs, parking notes, racket hire availability, and verified GhanaPostGPS digital addresses for smooth arrival.
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="card-solid feature-card">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
              <polyline points="17 2 12 7 7 2"></polyline>
            </svg>
          </div>
          <h3 class="feature-title">Leaderboard for the club TV</h3>
          <p class="feature-desc">
            Cast real-time match scores and cumulative tournament points to the clubhouse TV screen with dedicated full-screen presentation mode.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FOR ORGANISERS AND CLUBS (Gradient band - allowed placement) -->
  <section class="band-gradient-hero section-padded" id="for-clubs">
    <div class="container">
      <div class="clubs-grid">
        <div class="clubs-copy">
          <h2 class="clubs-title">For organisers and clubs</h2>
          <p class="clubs-subtitle">
            Manage court capacity, verify local payments effortlessly, and keep player communities active without administrative headache.
          </p>
          <div class="clubs-actions">
            <a href={siteConfig.whatsappUrl} class="btn btn-white-on-blue" id="clubs-whatsapp-cta">
              Talk to us on WhatsApp
            </a>
          </div>
        </div>

        <!-- 4 Glass Cards (Allowed placement on hero gradient) -->
        <div class="clubs-cards-grid">
          <div class="card-hero-glass">
            <div class="club-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--btn-on-blue-lime-bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </div>
            <h3 class="club-card-title">Duplicate events</h3>
            <p class="club-card-desc">
              Duplicate last week's event schedule and court assignments in one tap. Keep recurring weeknight sessions consistent.
            </p>
          </div>

          <div class="card-hero-glass">
            <div class="club-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--btn-on-blue-lime-bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
            <h3 class="club-card-title">Payment visibility</h3>
            <p class="club-card-desc">
              See who has paid at a glance with clear verified / unverified status toggles for MoMo reference numbers and cash check-ins.
            </p>
          </div>

          <div class="card-hero-glass">
            <div class="club-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--btn-on-blue-lime-bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </div>
            <h3 class="club-card-title">Export player lists</h3>
            <p class="club-card-desc">
              Download clean attendance sheets and player contact lists anytime for club record keeping and safety audits.
            </p>
          </div>

          <div class="card-hero-glass">
            <div class="club-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--btn-on-blue-lime-bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class="club-card-title">Fill quiet hours</h3>
            <p class="club-card-desc">
              Run spontaneous midday or late-night social sessions to boost utilization on your court during non-peak Accra hours.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. USE IT ON YOUR PHONE (Solid ice blue surface) -->
  <section class="section-padded band-ice-surface" id="pwa">
    <div class="container space-y-lg">
      <div class="section-header">
        <span class="section-eyebrow eyebrow-primary">No App Store Required</span>
        <h2 class="section-title">Use it on your phone</h2>
        <p class="section-subtitle">
          Works smoothly in the web browser on Android and iPhone with no heavy store download or constant updates.
        </p>
      </div>

      <div class="pwa-grid">
        <div class="pwa-steps">
          <div class="card-solid pwa-step-card">
            <div class="pwa-badge tnum">1</div>
            <div>
              <h3 class="pwa-step-title">Open browser</h3>
              <p class="pwa-step-desc">Open padelghana.com in your mobile browser on Safari, Chrome, or Firefox.</p>
            </div>
          </div>

          <div class="card-solid pwa-step-card">
            <div class="pwa-badge tnum">2</div>
            <div>
              <h3 class="pwa-step-title">Tap menu</h3>
              <p class="pwa-step-desc">Tap Share (iOS Safari) or Menu &vellip; (Android Chrome).</p>
            </div>
          </div>

          <div class="card-solid pwa-step-card">
            <div class="pwa-badge tnum">3</div>
            <div>
              <h3 class="pwa-step-title">Save icon</h3>
              <p class="pwa-step-desc">Select &ldquo;Add to Home Screen&rdquo; for instant 1-tap court access anytime.</p>
            </div>
          </div>
        </div>

        <div class="pwa-media">
          <img
            src="/images/phone-players.png"
            alt="A friendly group of Ghanaian padel players looking at a smartphone together courtside"
            class="pwa-photo"
            width="480"
            height="400"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FREQUENTLY ASKED QUESTIONS (Strictly solid surface per Rule 4) -->
  <section class="section-padded surface-base" id="faq">
    <div class="container max-w-narrow space-y-lg">
      <div class="section-header">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-subtitle">
          Clear answers to how matches, scoring, and payments work in Accra.
        </p>
      </div>

      <div class="faq-list">
        <details class="card-solid faq-item" open>
          <summary class="faq-summary">
            <span class="faq-question">How do I join an event?</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <p class="faq-answer">
            Select any upcoming tournament, social, or Americano from the club schedule. Hit join, choose your payment method, and you're in the draw once approved by the organizer.
          </p>
        </details>

        <details class="card-solid faq-item">
          <summary class="faq-summary">
            <span class="faq-question">How do I pay?</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <p class="faq-answer">
            Mobile money (MTN MoMo, Telecel Cash, AT Money) or cash at the club; organiser confirms your spot. Note online card payments are not live yet.
          </p>
        </details>

        <details class="card-solid faq-item">
          <summary class="faq-summary">
            <span class="faq-question">What is Americano?</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <p class="faq-answer">
            Americano is a social tournament format where you rotate partners every round. Everyone plays with everyone and against everyone. Points won in each game accumulate on your personal score sheet.
          </p>
        </details>

        <details class="card-solid faq-item">
          <summary class="faq-summary">
            <span class="faq-question">What do the levels mean?</span>
