---
import '../styles/tokens.css';
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Padel Ghana — Padel in Ghana, organised.",
  description = "Find games and players in Accra. Join Americano events at your level, enter scores on the court, and track live standings."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Preload Self-Hosted Inter Variable Font -->
  <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />

  <!-- OpenGraph Meta Tags -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GH" />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
  <TopNav />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
